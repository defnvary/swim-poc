# All read once in config.ts via a single zod schema; fail fast if invalid (03 §5).
# Never commit .env. Secrets are generated with: openssl rand -base64 32

# base domain, e.g. example.com (platform host = swim.example.com)
SWIM_DOMAIN=example.com
# email for Let's Encrypt
SWIM_ACME_EMAIL=admin@example.com
# base64, 32 bytes: AES-256-GCM key for PATs, webhook secrets, env values
SWIM_SECRET_KEY=
# base64, 32+ bytes: HS256 signing key
SWIM_JWT_SECRET=
# postgres://swim:<password>@swim-db:5432/swim
DATABASE_URL=postgres://swim:swim@localhost:5432/swim
# strong generated password (platform compose)
POSTGRES_PASSWORD=
# host docker group gid (build arg; lets the api run as non-root)
DOCKER_GID=
# seconds to wait for container health, default 120
SWIM_DEPLOY_TIMEOUT=120
# global concurrent builds, default 2
SWIM_MAX_BUILDS=2
# production
NODE_ENV=production
